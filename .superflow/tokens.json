{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "primary": { "$value": "#000000", "$type": "color" },
    "background": { "$value": "#FFFFFF", "$type": "color" },
    "text": { "$value": "#171717", "$type": "color" },
    "muted": { "$value": "#737373", "$type": "color" },
    "border": { "$value": "#E5E5E5", "$type": "color" },
    "danger": { "$value": "#DC2626", "$type": "color" }
  },
  "spacing": {
    "xs": { "$value": "4px", "$type": "dimension" },
    "sm": { "$value": "8px", "$type": "dimension" },
    "md": { "$value": "16px", "$type": "dimension" },
    "lg": { "$value": "24px", "$type": "dimension" },
    "xl": { "$value": "32px", "$type": "dimension" }
  },
  "typography": {
    "fontFamily": { "$value": "Inter", "$type": "fontFamily" },
    "heading": { "$value": "700", "$type": "fontWeight" },
    "body": { "$value": "400", "$type": "fontWeight" }
  },
  "roundness": {
    "radius": { "$value": "8px", "$type": "dimension" }
  }
}
